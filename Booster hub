local Players    = game:GetService("Players")
local Lighting   = game:GetService("Lighting")
local Workspace  = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local function notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 3
        })
    end)
end

notify("💀 RAM Killer v2", "Đang tối ưu...", 3)

-- 1) Graphics tối đa (đã bỏ property sai)
pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    settings().Rendering.ShadowMapSize = 0
    settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
end)

-- 2) BẢO VỆ: không xóa gì thuộc về nhân vật player
local function isProtected(inst)
    local ok, char = pcall(function() return player.Character end)
    if not ok or not char then return false end
    return inst:IsDescendantOf(char)
end

-- 3) Xóa effect — có kiểm tra bảo vệ + chỉ quét chỗ cần
local function nukeEffects(root)
    pcall(function()
        for _, v in ipairs(root:GetDescendants()) do
            if isProtected(v) then continue end  -- bỏ qua nhân vật

            if v:IsA("ParticleEmitter") or v:IsA("Trail")
            or v:IsA("Smoke") or v:IsA("Fire")
            or v:IsA("Sparkles") or v:IsA("Beam")
            or v:IsA("PointLight") or v:IsA("SpotLight")
            or v:IsA("SurfaceLight") then
                v:Destroy()
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            elseif v:IsA("Sound") then
                v:Destroy()
            end
        end
    end)
end

-- Quét 1 lần các khu vực chính
nukeEffects(Workspace)
nukeEffects(ReplicatedStorage)  -- thêm: nơi chứa effect template
nukeEffects(Lighting)

-- 4) Xóa lighting effect (bỏ Sky để khỏi trắng trời)
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e6
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") or fx:IsA("Atmosphere")
        or fx:IsA("Clouds") then
            fx:Destroy()
        end
    end
end)

-- 5) Tắt âm thanh (bỏ property sai)
pcall(function()
    for _, s in ipairs(game:GetService("SoundService"):GetDescendants()) do
        if s:IsA("Sound") then s:Destroy() end
    end
end)

-- 6) Dọn rác THÔNG MINH: mỗi 5s, chỉ quét khi cần
local lastClean = 0
RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastClean < 5 then return end  -- 5s/lần, không phải 2s
    lastClean = now
    pcall(function() collectgarbage("collect") end)
    nukeEffects(Workspace)  -- quét nhẹ, có bảo vệ char
end)

-- 7) Network (giữ nguyên — có ích khi treo lâu)
pcall(function()
    settings().Network.IncomingReplicationLag = 0.1
end)

notify("✅ RAM Killer v2", "Tối ưu xong!", 3)
