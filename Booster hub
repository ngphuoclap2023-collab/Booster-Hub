--[[ RAM KILLER — Dành cho treo AFK game nặng
     Mục tiêu: giảm RAM tối đa, không cần đẹp
--]]

local Players    = game:GetService("Players")
local Lighting   = game:GetService("Lighting")
local Workspace  = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "💀 RAM Killer", Text = "Đang dọn RAM...", Duration = 3
    })
end)

-- 1) Hạ graphics tối đa (giảm texture load = giảm RAM nhiều nhất)
pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    settings().Rendering.ShadowMapSize = 0
    settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    settings().Rendering.Edition = "Disabled"
end)

-- 2) XÓA HẲN (không phải tắt) mọi effect
local function nukeEffects(root)
    pcall(function()
        for _, v in ipairs(root:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail")
            or v:IsA("Smoke") or v:IsA("Fire")
            or v:IsA("Sparkles") or v:IsA("Beam")
            or v:IsA("PointLight") or v:IsA("SpotLight")
            or v:IsA("SurfaceLight") then
                v:Destroy()
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy()
            elseif v:IsA("Sound") then
                v:Destroy()
            end
        end
    end)
end
nukeEffects(Workspace)

-- 3) Xóa toàn bộ lighting effect
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e6
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") or fx:IsA("Sky")
        or fx:IsA("Atmosphere") or fx:IsA("Clouds") then
            fx:Destroy()
        end
    end
end)

-- 4) Tắt âm thanh toàn cục (giảm CPU + RAM audio decode)
pcall(function()
    game:GetService("SoundService").RespectFilteringEnabled = true
    for _, s in ipairs(game:GetService("SoundService"):GetDescendants()) do
        if s:IsA("Sound") then s:Destroy() end
    end
end)

-- 5) Dọn rác Lua liên tục (mạnh hơn bản cũ)
task.spawn(function()
    while task.wait(2) do
        pcall(function() collectgarbage("collect") end)
        nukeEffects(Workspace)  -- dọn effect mới spawn
    end
end)

-- 6) Giảm tải network (ping ổn định khi treo lâu)
pcall(function()
    settings().Network.IncomingReplicationLag = 0.1
end)

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "✅ Xong!", Text = "RAM đã tối ưu tối đa", Duration = 3
    })
end)
